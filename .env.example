# CrewML environment configuration — copy to .env and fill in.
# .env is git-ignored and never committed.

# --- LLM provider ---
# Default provider: "groq" (Llama 3.3 70B). Falls back to "mock" if no key.
CREWML_LLM_PROVIDER=groq

# Groq API key (https://console.groq.com). Leave blank to force mock mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Anthropic (Claude) provider for the provider-study (Day 16).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Run budgets (safety caps, tightened in Phase 4) ---
CREWML_MAX_ITERATIONS=3
CREWML_EXECUTOR_TIMEOUT_S=120
CREWML_RUN_TOKEN_BUDGET=200000

# --- Reproducibility ---
CREWML_SEED=42
